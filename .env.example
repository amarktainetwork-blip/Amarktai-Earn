AMARKTAI_ENV=development
DJANGO_SECRET_KEY=replace-with-strong-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,earn.amarktai.co.za
DJANGO_CSRF_TRUSTED_ORIGINS=https://earn.amarktai.co.za
DJANGO_DB_ENGINE=postgres
POSTGRES_DB=amarktai_earn
POSTGRES_USER=amarktai
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
BACKUP_PASSPHRASE=replace-with-at-least-32-random-characters
REDIS_URL=redis://redis:6379/0
JWT_ISSUER=amarktai-earn
JWT_AUDIENCE=amarktai-earn-owner
JWT_ACTIVE_KID=v1
JWT_SIGNING_KEYS_JSON={"v1":"replace-with-at-least-64-random-bytes"}
JWT_ACCESS_SECONDS=900
JWT_REFRESH_SECONDS=1209600
FIELD_ENCRYPTION_ACTIVE_KID=v1
FIELD_ENCRYPTION_KEYS_JSON={"v1":"REPLACE_WITH_FERNET_KEY"}
COOKIE_SECURE=1
GENX_API_KEY=
GENX_BASE_URL=https://query.genx.sh
GENX_TIMEOUT_SECONDS=30
AGENTGIGS_API_KEY=
AGENTGIGS_BASE_URL=https://www.agentgigs.io
AGENTGIGS_TIMEOUT_SECONDS=20
AGENTGIGS_WEBHOOK_SECRET=
AGENTGIGS_WATCHER_ENABLED=0
AGENTGIGS_WATCHER_INTERVAL_SECONDS=60
AGENTGIGS_AUTO_APPLY_ENABLED=0
AGENTGIGS_MAX_APPLICATIONS_PER_CYCLE=2
AGENTGIGS_EXECUTABLE_CATEGORIES=Data Analysis
AGENTGIGS_PROPOSAL_BUDGET_POSITION=0.50
AGENTGIGS_P_ACQUIRE_PRIOR=0.15
AGENTGIGS_P_ACCEPT_PRIOR=0.85
AGENTGIGS_P_PAYMENT_PRIOR=0.98
AGENTGIGS_EXPECTED_GENX_COST_USD=0.25
AGENTGIGS_EXPECTED_EXTERNAL_COST_USD=0
AGENTGIGS_ESTIMATED_MINUTES_PRIOR=60
AGENTGIGS_MAX_GENX_CREDITS=0
AGENTGIGS_MAX_SOURCE_ASSET_BYTES=26214400
AGENTGIGS_MAX_ASSET_SYNC_JOBS_PER_CYCLE=4
AUTONOMOUS_MODE=OFF
MIN_EXPECTED_PROFIT_USD=1.00
MIN_EXPECTED_PROFIT_PER_MINUTE_USD=0.05
MAX_GENX_COST_PER_JOB_USD=2.00
AMARKTAI_JOB_ROOT=/var/lib/amarktai-earn/jobs
AMARKTAI_UPLOAD_ROOT=/var/lib/amarktai-earn/uploads
JOB_LOCK_LEASE_SECONDS=1800
MAX_DETERMINISTIC_REPAIR_ATTEMPTS=1
MAX_ACTIVE_JOBS=4
CADDY_EMAIL=
AMARKTAI_REPO_ROOT=/var/lib/amarktai-earn/repos
GITHUB_TOKEN=
GITHUB_API_VERSION=2022-11-28
GITHUB_REPOSITORY_TIMEOUT_SECONDS=30
GITHUB_REPOSITORY_MAX_ARCHIVE_BYTES=26214400
GITHUB_REPOSITORY_MAX_UNPACKED_BYTES=104857600
GITHUB_REPOSITORY_MAX_FILES=5000
SANDBOX_CODING_ENABLED=0
SANDBOX_TOKEN_SECRET=
SANDBOX_TOKEN_TTL_SECONDS=1800
SANDBOX_BROKER_SECRET=
SANDBOX_BROKER_URL=http://sandbox-broker:8090
SANDBOX_BROKER_TIMEOUT_SECONDS=1200
SANDBOX_GENX_PROXY_PORT=8081
SANDBOX_LLM_BASE_URL=http://genx-proxy:8081/v1
SANDBOX_AGENT_IMAGE=amarktai-earn-sandbox:phase8c
SANDBOX_REPOSITORY_VOLUME=amarktai_repo_cache
SANDBOX_LLM_NETWORK=amarktai_sandbox_llm
SANDBOX_MEMORY_LIMIT=1024m
SANDBOX_CPU_LIMIT=1.5
SANDBOX_PIDS_LIMIT=256
SANDBOX_EXECUTION_TIMEOUT_SECONDS=900
SANDBOX_LLM_ESTIMATED_CREDITS=0.25
SANDBOX_LLM_TIMEOUT_SECONDS=180
SANDBOX_LLM_MAX_REQUEST_BYTES=2097152
DOCKER_GID=999
